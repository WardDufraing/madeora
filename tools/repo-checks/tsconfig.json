{
  "extends": "@madeora/config/tsconfig/library.json",
  "compilerOptions": {
    // The CLIs run directly with Node's built-in TypeScript type stripping (Node 22.18+),
    // so imports name the .ts file and only erasable TypeScript syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "*.ts"]
}
