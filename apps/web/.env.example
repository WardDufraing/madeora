# Copy to .env.local in this folder (apps/web) and fill in values for your machine.
# Never commit .env.local or real credentials.

# Server-only. Which environment this server runs in:
# development | test | preview | staging | production
APP_ENV=development

# Public (bundled into browser code). Absolute URL of the web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public (bundled into browser code). The Supabase project the app signs people in with.
# Local stack: run `pnpm db:start`, then copy the API URL and the publishable key that
# `pnpm exec supabase status` prints. Never use a secret or service_role key here: the app refuses one.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public (bundled into browser code). Cloudflare Turnstile site key (ADR 0008). Leave empty locally:
# without it the sign-in forms show no security check. Required in production (APP_ENV=production),
# where Supabase Auth's CAPTCHA protection verifies the token. Never paste the Turnstile secret key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Whether the app's own email (invitations, notifications) is sent in this environment
# (ADR 0018): resend | mailpit | off (default: off, then email invitations are not offered). The web
# app never sends email itself: the database queues it and a Trigger.dev job sends it, so the
# provider's key, sender and address live in Trigger.dev (docs/trigger-setup.md), not here. Locally,
# mailpit means "the local mail catcher of the Supabase stack"; it is refused outside development
# and test.
EMAIL_TRANSPORT=
