# Copy to .env.local in this folder (apps/web) and fill in values for your machine.
# Never commit .env.local or real credentials.

# Server-only. Which environment this server runs in:
# development | test | preview | staging | production
APP_ENV=development

# Public (bundled into browser code). Absolute URL of the web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public (bundled into browser code). The Supabase project the app signs people in with.
# Local stack: run `pnpm db:start`, then copy the API URL and the publishable key that
# `pnpm exec supabase status` prints. Never use a secret or service_role key here: the app refuses one.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
