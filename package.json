{
  "name": "madeora",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@madeora/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.8"
  }
}
