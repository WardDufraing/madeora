# Copy to .env in this folder (packages/jobs) for `trigger.dev dev` on your machine; the CLI loads it.
# Never commit .env or real credentials. Hosted environments set these in the Trigger.dev dashboard
# (Project → Environment Variables), never in Vercel. See docs/trigger-setup.md.

# The Trigger.dev project (not secret, from the dashboard: Project settings → Project ref).
TRIGGER_PROJECT_REF=

# Which environment the job runs belong to: development | test | preview | staging | production
APP_ENV=development

# The Supabase project the dispatcher and jobs use. Locally: the API URL from
# `pnpm exec supabase status`. Never a production project for development.
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret: that project's secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Email (S14). Unset or off: jobs record "not_configured" and in-app notifications still work.
# resend (hosted) | mailpit (your machine only: the Supabase stack's catcher, http://127.0.0.1:54324)
EMAIL_TRANSPORT=off
# The sender, on the verified domain: Madeora Dev <no-reply@madeora.test> locally,
# Madeora <no-reply@mail.madeora.studio> hosted.
EMAIL_FROM=
# Hosted only. Server-only secret (re_...): this environment's Resend key (docs/email-setup.md).
RESEND_API_KEY=
MAILPIT_URL=
# The web app's address, for the links in emails (required when email is on). https in production.
APP_URL=http://127.0.0.1:3000
